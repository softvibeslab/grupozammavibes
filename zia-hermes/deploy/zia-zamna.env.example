# /var/lib/zia-zamna/service.env  (chmod 600, dueño ziazamna) — NUNCA en git
PORT=4661
ZIA_ORIGINS=https://zamna.softvibes.art
# Perfil de Hermes conectado (lo llena conectar-perfil.sh)
ZIA_PROFILE_NAME=
ZIA_SOUL_FILE=/var/lib/zia-zamna/perfil/SOUL.md
ZIA_KNOWLEDGE_FILE=/opt/zia-zamna/conocimiento.md
# Runtime de Hermes ya instalado en el VPS
HERMES_PYTHON=/usr/local/lib/hermes-agent/venv/bin/python
HERMES_RUNTIME=/usr/local/lib/hermes-agent
HERMES_HOME=/var/lib/zia-zamna/.hermes
# Modelo (mismo esquema que skool-guide)
ZIA_PROVIDER=openrouter
ZIA_BASE_URL=https://openrouter.ai/api/v1
ZIA_MODEL=openai/gpt-4.1-mini
OPENROUTER_API_KEY=
# Límites
ZIA_IP_LIMIT=12
ZIA_IP_WINDOW=300
ZIA_DAILY_BUDGET=400
ZIA_CONCURRENCY=3
